# RouteMaster AI Service — Environment Variables Example
# Copy to .env and fill in actual values. NEVER commit .env to version control.

# ── Service ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
AI_SERVICE_PORT=8001

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, restrict to the SDE backend URL only.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Never commit credentials. Use a secrets manager in production.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=routemaster
MONGODB_COLLECTION_COURSES=courses
MONGODB_COLLECTION_CAREERS=careers
MONGODB_COLLECTION_PROJECTS=projects
MONGODB_COLLECTION_SKILLS=skills

# ── Vector Search ─────────────────────────────────────────────────────────────
VECTOR_SEARCH_INDEX=routemaster_vector_index
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── AI Engine Paths (relative to repo root) ───────────────────────────────────
PROCESSED_DIR=data/processed
MODEL_DIR=model

# ── Default Result Limits ─────────────────────────────────────────────────────
DEFAULT_COURSE_RESULTS=5
DEFAULT_PROJECT_RESULTS=5
DEFAULT_COURSES_PER_SKILL=3
DEFAULT_PROJECTS_PER_SKILL=2
DEFAULT_CAREER_RESULTS=5
